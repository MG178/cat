<Page x:Class="catprogram.Views.QrPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
      mc:Ignorable="d"
      Background="Transparent">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="QR" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Генерация и состояние QR-сессий" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Сгенерировать" Command="{Binding GenerateQrCommand}" Margin="0,0,10,0" />
                        <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,0" />
                        <Button Content="Скопировать" Command="{Binding CopyLatestQrCommand}" Style="{StaticResource SurfaceButtonStyle}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Background="#122033" CornerRadius="18" Padding="16" BorderBrush="#22324A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Код" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LatestQrCode}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="QR-сессии" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding QrSessions}" SelectedItem="{Binding SelectedQrSession, Mode=TwoWay}" AutoGenerateColumns="False" Height="540">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Событие" Binding="{Binding ScheduleLabel}" Width="*" />
                            <DataGridTextColumn Header="Код" Binding="{Binding QrCodeData}" Width="220" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding StateText}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Предпросмотр" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Border Background="#F6F8FA" CornerRadius="18" Padding="12" HorizontalAlignment="Left">
                        <Image Source="{Binding QrPreview}" Width="220" Height="220" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="{Binding SelectedSchedule.DisplayName}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="Время жизни: " Foreground="{StaticResource TextMutedBrush}" FontSize="12" /><TextBlock Text="{Binding ExpiresMinutes}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" /></StackPanel>
                    <TextBox Text="{Binding ExpiresMinutes, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,0" Width="120" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
