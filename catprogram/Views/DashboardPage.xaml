<Page x:Class="catprogram.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="Transparent">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Панель управления" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="Сводка по базе, текущему пользователю и быстрым действиям" FontSize="14" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
                    <UniformGrid Columns="4" Margin="0,18,0,0">
                        <Border Background="#122033" CornerRadius="16" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="Пользователи" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/><TextBlock Text="{Binding Dashboard.TotalUsers}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Background="#122033" CornerRadius="16" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="Группы" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/><TextBlock Text="{Binding Dashboard.TotalGroups}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Background="#122033" CornerRadius="16" Padding="14" Margin="0,0,10,0"><StackPanel><TextBlock Text="Предметы" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/><TextBlock Text="{Binding Dashboard.TotalSubjects}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
                        <Border Background="#122033" CornerRadius="16" Padding="14"><StackPanel><TextBlock Text="QR-сессии" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/><TextBlock Text="{Binding Dashboard.ActiveQrSessions}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
                    </UniformGrid>
                </StackPanel>

                <Border Grid.Column="2" Background="#122033" CornerRadius="18" Padding="16" BorderBrush="#22324A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Текущий пользователь" FontSize="14" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding CurrentUserName}" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding CurrentUserRole}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,14,0,0" TextWrapping="Wrap"><Run Text="База: "/><Run Text="{Binding Dashboard.DatabasePath}"/></TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Быстрый статус" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Последние QR-сессии" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <DataGrid ItemsSource="{Binding QrSessions}" SelectedItem="{Binding SelectedQrSession, Mode=TwoWay}" AutoGenerateColumns="False" Height="320">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Событие" Binding="{Binding ScheduleLabel}" Width="*" />
                            <DataGridTextColumn Header="Код" Binding="{Binding QrCodeData}" Width="220" />
                            <DataGridTextColumn Header="Статус" Binding="{Binding StateText}" Width="120" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Текущий QR" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Border Background="#F6F8FA" CornerRadius="18" Padding="12" HorizontalAlignment="Left">
                        <Image Source="{Binding QrPreview}" Width="220" Height="220" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="{Binding LatestQrCode}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <Button Content="Скопировать код" Command="{Binding CopyLatestQrCommand}" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
