<Page x:Class="catprogram.Views.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
      mc:Ignorable="d"
      Background="Transparent">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Пользователи" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="CRUD без скролла всей страницы — список ограничен по высоте, скролл только внутри таблицы" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
                    <UniformGrid Columns="2" Margin="0,18,0,0">
                        <Button Content="Новый" Command="{Binding CreateUserCommand}" Margin="0,0,10,0" />
                        <Button Content="Обновить" Command="{Binding UpdateUserCommand}" Style="{StaticResource GhostButtonStyle}" Margin="10,0,0,0" />
                        <Button Content="Удалить" Command="{Binding DeleteUserCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,10,10,0" />
                        <Button Content="Очистить" Command="{Binding RefreshCommand}" Style="{StaticResource SurfaceButtonStyle}" Margin="10,10,0,0" />
                    </UniformGrid>
                </StackPanel>

                <Border Grid.Column="2" Background="#122033" CornerRadius="18" Padding="16" BorderBrush="#22324A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Карточка пользователя" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedUser.FullName}" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SelectedUser.Email}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding SelectedUser.DisplayName}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1.05*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Список" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}" AutoGenerateColumns="False" Height="540">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="220" />
                            <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="120" />
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Форма" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="ФИО" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBox Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                        <TextBlock Text="Email" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBox Text="{Binding NewUserEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                        <TextBlock Text="Пароль" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBox Text="{Binding NewUserPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                        <TextBlock Text="Роль" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding NewUserRoleId, Mode=TwoWay}" Margin="0,6,0,12" />
                        <TextBlock Text="Группа" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <ComboBox ItemsSource="{Binding Groups}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding NewUserGroupId, Mode=TwoWay}" Margin="0,6,0,12" />
                        <TextBlock Text="Выбранный пользователь меняется через таблицу слева" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
