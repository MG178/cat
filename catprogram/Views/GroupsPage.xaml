<Page x:Class="catprogram.Views.GroupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="Transparent">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Группы" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Список и карточка без длинной страницы" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
                    <UniformGrid Columns="2" Margin="0,18,0,0">
                        <Button Content="Создать" Command="{Binding CreateGroupCommand}" Margin="0,0,10,0" />
                        <Button Content="Обновить" Command="{Binding UpdateGroupCommand}" Style="{StaticResource GhostButtonStyle}" Margin="10,0,0,0" />
                        <Button Content="Удалить" Command="{Binding DeleteGroupCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,10,10,0" />
                        <Button Content="Сброс" Command="{Binding RefreshCommand}" Style="{StaticResource SurfaceButtonStyle}" Margin="10,10,0,0" />
                    </UniformGrid>
                </StackPanel>

                <Border Grid.Column="2" Background="#122033" CornerRadius="18" Padding="16" BorderBrush="#22324A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Карточка группы" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedGroup.DisplayName}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SelectedGroup.Department}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Таблица" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" AutoGenerateColumns="False" Height="540">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Курс" Binding="{Binding Course}" Width="90" />
                            <DataGridTextColumn Header="Факультет" Binding="{Binding Department}" Width="220" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Форма" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="Название" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                    <TextBlock Text="Курс" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding NewGroupCourse, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                    <TextBlock Text="Факультет" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding NewGroupDepartment, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
