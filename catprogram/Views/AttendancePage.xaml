<Page x:Class="catprogram.Views.AttendancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
      mc:Ignorable="d"
      Background="Transparent">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Посещаемость" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Ввод кода и просмотр журнала без общего scroll" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <TextBox Text="{Binding ScanQrCode, UpdateSourceTrigger=PropertyChanged}" Width="360" Margin="0,0,10,0" />
                        <Button Content="Отметить" Command="{Binding ScanAttendanceCommand}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2" Background="#122033" CornerRadius="18" Padding="16" BorderBrush="#22324A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Статус" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Журнал" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                <DataGrid ItemsSource="{Binding Attendance}" AutoGenerateColumns="False" Height="620">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Студент" Binding="{Binding UserName}" Width="220" />
                        <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="120" />
                        <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="*" />
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Время" Binding="{Binding ScannedAtText}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </Grid>
</Page>
