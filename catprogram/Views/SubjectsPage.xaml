<Page x:Class="catprogram.Views.SubjectsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
      mc:Ignorable="d"
      Background="Transparent">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Предметы" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Отдельная frame-страница под сущность" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
                    <UniformGrid Columns="2" Margin="0,18,0,0">
                        <Button Content="Создать" Command="{Binding CreateSubjectCommand}" Margin="0,0,10,0" />
                        <Button Content="Обновить" Command="{Binding UpdateSubjectCommand}" Style="{StaticResource GhostButtonStyle}" Margin="10,0,0,0" />
                        <Button Content="Удалить" Command="{Binding DeleteSubjectCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,10,10,0" />
                        <Button Content="Сброс" Command="{Binding RefreshCommand}" Style="{StaticResource SurfaceButtonStyle}" Margin="10,10,0,0" />
                    </UniformGrid>
                </StackPanel>

                <Border Grid.Column="2" Background="#122033" CornerRadius="18" Padding="16" BorderBrush="#22324A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Карточка предмета" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedSubject.Name}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SelectedSubject.TeacherName}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Таблица" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding Subjects}" SelectedItem="{Binding SelectedSubject, Mode=TwoWay}" AutoGenerateColumns="False" Height="540">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Преподаватель" Binding="{Binding TeacherName}" Width="220" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Форма" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="Название" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding NewSubjectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                    <TextBlock Text="Преподаватель" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <ComboBox ItemsSource="{Binding Users}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding NewSubjectTeacherId, Mode=TwoWay}" Margin="0,6,0,12" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
