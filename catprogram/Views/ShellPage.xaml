<Page x:Class="catprogram.Views.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="Transparent">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock Text="Навигация" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentUserName}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CurrentUserRole}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Content="Панель" Command="{Binding NavigateDashboardCommand}" Margin="0,0,0,8" />
                        <Button Content="Пользователи" Command="{Binding NavigateUsersCommand}" Margin="0,0,0,8" Visibility="{Binding CanSeeAdminSections, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Группы" Command="{Binding NavigateGroupsCommand}" Margin="0,0,0,8" Visibility="{Binding CanSeeAdminSections, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Предметы" Command="{Binding NavigateSubjectsCommand}" Margin="0,0,0,8" Visibility="{Binding CanSeeAdminSections, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Content="Расписание" Command="{Binding NavigateScheduleCommand}" Margin="0,0,0,8" />
                        <Button Content="QR" Command="{Binding NavigateQrCommand}" Margin="0,0,0,8" />
                        <Button Content="Посещаемость" Command="{Binding NavigateAttendanceCommand}" Margin="0,0,0,8" />
                        <Button Content="Обновить всё" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Frame Grid.Column="2" x:Name="SectionFrame" NavigationUIVisibility="Hidden" Background="Transparent" />
    </Grid>
</Page>
