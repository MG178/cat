<Page x:Class="catprogram.Views.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="Transparent">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock Text="Навигация" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Button Content="Панель" Command="{Binding RefreshCommand}" Margin="0,0,0,8" />
                <Button Content="Пользователи" Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,8" />
                <Button Content="Группы" Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,8" />
                <Button Content="Предметы" Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,8" />
                <Button Content="Расписание" Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,8" />
                <Button Content="QR" Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,8" />
                <Button Content="Посещаемость" Style="{StaticResource GhostButtonStyle}" Margin="0,0,0,8" />
            </StackPanel>
        </Border>

        <Frame Grid.Column="2" NavigationUIVisibility="Hidden" Background="Transparent" />
    </Grid>
</Page>