<Page x:Class="catprogram.Views.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
      mc:Ignorable="d"
      Background="Transparent">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Расписание" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Окно с множеством frame-страниц и роль-зависимыми разделами" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0" />
                    <UniformGrid Columns="2" Margin="0,18,0,0">
                        <Button Content="Создать" Command="{Binding CreateScheduleCommand}" Margin="0,0,10,0" />
                        <Button Content="Обновить" Command="{Binding UpdateScheduleCommand}" Style="{StaticResource GhostButtonStyle}" Margin="10,0,0,0" />
                        <Button Content="Удалить" Command="{Binding DeleteScheduleCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,10,10,0" />
                        <Button Content="Сброс" Command="{Binding RefreshCommand}" Style="{StaticResource SurfaceButtonStyle}" Margin="10,10,0,0" />
                    </UniformGrid>
                </StackPanel>

                <Border Grid.Column="2" Background="#122033" CornerRadius="18" Padding="16" BorderBrush="#22324A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Карточка занятия" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedSchedule.DisplayName}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SelectedSchedule.Room}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Таблица" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <DataGrid ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}" AutoGenerateColumns="False" Height="540">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="120" />
                            <DataGridTextColumn Header="Предмет" Binding="{Binding SubjectName}" Width="*" />
                            <DataGridTextColumn Header="День" Binding="{Binding DayOfWeek}" Width="110" />
                            <DataGridTextColumn Header="Время" Binding="{Binding StartTime}" Width="100" />
                            <DataGridTextColumn Header="Кабинет" Binding="{Binding Room}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Форма" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="Группа" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <ComboBox ItemsSource="{Binding Groups}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding NewScheduleGroupId, Mode=TwoWay}" Margin="0,6,0,12" />
                    <TextBlock Text="Предмет" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <ComboBox ItemsSource="{Binding Subjects}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding NewScheduleSubjectId, Mode=TwoWay}" Margin="0,6,0,12" />
                    <TextBlock Text="Преподаватель" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <ComboBox ItemsSource="{Binding Users}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding NewScheduleTeacherId, Mode=TwoWay}" Margin="0,6,0,12" />
                    <TextBlock Text="Кабинет" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding NewScheduleRoom, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                    <TextBlock Text="Начало" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding NewScheduleStartTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                    <TextBlock Text="Конец" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding NewScheduleEndTime, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                    <TextBlock Text="День" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding NewScheduleDay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                    <TextBlock Text="Тип" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBox Text="{Binding NewScheduleLessonType, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
